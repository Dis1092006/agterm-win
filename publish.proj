<Project>

  <!--
    Publishes the app directory and its native companion CLI together:

        dotnet build publish.proj                                  x64 -> artifacts\publish\agterm-win\release_x64
        dotnet build publish.proj -p:RunnablePlatform=ARM64
        dotnet build publish.proj -p:RunnableOutDir=C:\tools\agterm-win

    AgTerm.App (agterm-win.exe) is self-contained (WindowsPackageType=None,
    WindowsAppSDKSelfContained=true), so it publishes as ~230 files beside the exe. DebugType=none drops the .pdb files.

    The app is NOT single-file, and that is a startup decision. PublishSingleFile produces a 220 MB
    exe that unpacks itself into %TEMP%\.net\agterm-win\<bundle id> before any code runs. The id is
    per build, so every new build paid the unpack again and left the old copy behind: 1.4 GB across
    8 directories on the development machine. Measured on this machine, window shown after launch:

        single file   34.9 s first run of a build, 4.4 s afterwards
        directory      5.0 s first run,            1.0 s afterwards

    The bundle costs on every launch, not only the first. agtermctl uses Native AOT, so it is one
    native exe without the CLR startup or a runtime bundle to extract.

    agtermctl is self-contained too, and it has to be. A framework-dependent apphost looks for
    hostfxr.dll beside itself first; the app's self-contained runtime puts one there, so the CLI takes
    that directory for a self-contained install, finds no shared\Microsoft.NETCore.App in it and fails
    with "You must install or update .NET" even when .NET is installed. A Native AOT exe does not
    load hostfxr and never looks at its neighbours.

    Two publishes rather than one: the SDK's artifacts layout separates publish output per project, so
    landing both exes in one directory takes an explicit PublishDir.

    This is a standalone project rather than a target in Directory.Build.targets, because that file is
    imported into every project in the tree: the target would run once per project, and the parallel
    runs would delete each other's output.
  -->

  <PropertyGroup>
    <!-- x64 or ARM64: AgTerm.App declares only these two, never AnyCPU. -->
    <RunnablePlatform Condition="'$(RunnablePlatform)' == ''">x64</RunnablePlatform>
    <RunnableConfiguration Condition="'$(RunnableConfiguration)' == ''">Release</RunnableConfiguration>

    <!-- win-x64 / win-arm64: the runtime identifier, derived from the msbuild Platform name. -->
    <_Rid>win-$(RunnablePlatform.ToLowerInvariant())</_Rid>
    <_Pivot>$(RunnableConfiguration.ToLowerInvariant())_$(RunnablePlatform.ToLowerInvariant())</_Pivot>
    <_OutDir Condition="'$(RunnableOutDir)' == ''">$(MSBuildThisFileDirectory)artifacts\publish\agterm-win\$(_Pivot)</_OutDir>
    <_OutDir Condition="'$(RunnableOutDir)' != ''">$(RunnableOutDir)</_OutDir>
  </PropertyGroup>

  <Target Name="Build">

    <!-- A stale exe left by an earlier run would read as a successful publish, so start clean. -->
    <RemoveDir Directories="$(_OutDir)" />

    <!-- Restore first, and with the same RID: publishing for a runtime identifier needs a
         RID-specific assets file, and the MSBuild task below does not restore on its own
         (NETSDK1047 otherwise). Restore;Publish in one call would reuse the pre-restore
         evaluation, so the two targets run as separate calls. -->
    <Message Importance="high" Text="Publishing AgTerm.App ($(_Rid)) to $(_OutDir)" />
    <!-- SelfContained=true is required, not incidental: without it the exe is framework-dependent
         and needs .NET 10 installed on the target machine. Setting RuntimeIdentifier alone does not
         imply it. PublishSingleFile is deliberately absent here; see the note above. -->
    <MSBuild Projects="$(MSBuildThisFileDirectory)src\AgTerm.App\AgTerm.App.csproj"
             Targets="Restore"
             Properties="Configuration=$(RunnableConfiguration);Platform=$(RunnablePlatform);RuntimeIdentifier=$(_Rid);SelfContained=true" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)src\AgTerm.App\AgTerm.App.csproj"
             Targets="Publish"
             Properties="Configuration=$(RunnableConfiguration);Platform=$(RunnablePlatform);RuntimeIdentifier=$(_Rid);SelfContained=true;DebugType=none;PublishDir=$(_OutDir)\" />

    <Message Importance="high" Text="Publishing agtermctl ($(_Rid), Native AOT)" />
    <!-- Native tool discovery needs vswhere on PATH. Scope it to the child publish process. -->
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)src\AgTerm.Cli\AgTerm.Cli.csproj&quot; -c &quot;$(RunnableConfiguration)&quot; -r &quot;$(_Rid)&quot; --self-contained true -p:DebugType=none -o &quot;$(_OutDir)\.&quot;"
          EnvironmentVariables="PATH=$([MSBuild]::Escape('$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer;$(PATH)'))" />

    <!-- MIT asks for the notices in every copy, and this directory is the copy people take. -->
    <Copy SourceFiles="$(MSBuildThisFileDirectory)LICENSE;$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md" DestinationFolder="$(_OutDir)" />

    <ItemGroup>
      <_Published Include="$(_OutDir)\*" />
      <_PublishedExe Include="$(_OutDir)\*.exe" />
    </ItemGroup>
    <Message Importance="high" Text="Published to $(_OutDir): @(_PublishedExe->'%(Filename)%(Extension)', ', ') (@(_Published->Count()) files)" />

  </Target>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgTerm.Xterm.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgTerm.ControlServer\AgTerm.ControlServer.csproj" />
    <ProjectReference Include="..\AgTerm.Terminal\AgTerm.Terminal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- the terminal page + pinned xterm.js bundles ship next to the assembly (no CDN).
         WebView2 serves them through MapVirtualHostToFolder(XtermAssets.Directory), which needs a
         directory on disk. Under PublishSingleFile they must stay INSIDE the bundle: it extracts
         to a temp directory and AppContext.BaseDirectory points there, not next to the exe, so
         ExcludeFromSingleFile would leave the app looking in the extraction folder for files that
         were never packed into it (the page then fails with ERR_FILE_NOT_FOUND). This is the
         opposite of Integration\** below, whose paths are handed to a shell.
         CopyToPublishDirectory covers the non-single-file layouts, where the published project is
         AgTerm.App and a referenced project's None items would otherwise stop at a build output. -->
    <None Include="Assets\**"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <!-- per-shell cwd-reporting scripts, dot-sourced by the spawned shell (ShellIntegration).
         They must exist as REAL FILES next to the exe at run time, because a shell is handed a
         path to them: ExcludeFromSingleFile keeps PublishSingleFile from packing them into the
         bundle, where no shell could open them. A layout missing them still spawns a plain
         working shell, only without cwd reporting. -->
    <None Include="Integration\**"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- upstream's theme files ship inside the assembly, so a directory publish, a single-file
         publish and a test run all carry the same catalog, and no run-time state has a missing
         theme folder. %(Extension) keeps a dotted name such as Hopscotch.256 whole. The SDK's
         default None glob also matches these extension-less files; removing them keeps one
         item per file. -->
    <None Remove="Themes\**" />
    <EmbeddedResource Include="Themes\ghostty\*;Themes\agterm"
                      LogicalName="themes/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>

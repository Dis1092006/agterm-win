<UserControl
    x:Class="AgTerm.App.KeybindingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:keymap="using:AgTerm.Core.Keymap"
    Visibility="Collapsed"
    TabFocusNavigation="Cycle"
    PreviewKeyDown="OnPreviewKeyDown"
    LosingFocus="OnLosingFocus"
    AutomationProperties.Name="Keyboard Shortcuts">
    <UserControl.Resources>
        <CollectionViewSource x:Name="GroupedRows" IsSourceGrouped="True" ItemsPath="Items" />
    </UserControl.Resources>
    <Grid Background="#66000000">
        <Border x:Name="KeybindingsPanel" MaxWidth="840" MaxHeight="700" Margin="24,48,24,24" Padding="20"
                Style="{StaticResource OverlayPanelStyle}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Keyboard Shortcuts" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Read-only. Changes to keymap.conf appear after keymap reload."
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Close" Click="OnCloseClick"
                            AutomationProperties.Name="Close keyboard shortcuts" />
                </Grid>
                <TextBox x:Name="QueryBox" Grid.Row="1" PlaceholderText="Search keyboard shortcuts"
                         TextChanged="OnQueryChanged" AutomationProperties.Name="Search keyboard shortcuts" />
                <ListView x:Name="Results" Grid.Row="2" ItemsSource="{Binding Source={StaticResource GroupedRows}}"
                          SelectionMode="None" IsItemClickEnabled="False"
                          AutomationProperties.Name="Effective keyboard shortcuts">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate x:DataType="keymap:KeybindingGroup">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" Margin="0,12,0,6" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="keymap:KeybindingRow">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Id}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" MaxWidth="280">
                                    <TextBlock Text="{x:Bind Shortcut}" HorizontalAlignment="Right" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Status}" HorizontalAlignment="Right" TextWrapping="Wrap"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyMessage" Grid.Row="2" Text="No matching keyboard shortcuts."
                           Visibility="Collapsed" Margin="8" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

<Window
    x:Class="AgTerm.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgTerm.App"
    Title="agterm">
    <Grid x:Name="RootGrid" KeyDown="OnRootKeyDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="220" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <local:SidebarView x:Name="Sidebar" Grid.Column="0" />
        <Border x:Name="SidebarDivider" Grid.Column="1" Width="4"
                Background="Transparent"
                PointerPressed="OnDividerPressed"
                PointerMoved="OnDividerMoved"
                PointerReleased="OnDividerReleased" />
        <WebView2 x:Name="TerminalView" Grid.Column="2" />
    </Grid>
</Window>

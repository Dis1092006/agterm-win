<Window
    x:Class="AgTerm.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgTerm.App"
    Title="agterm-win">
    <Grid x:Name="RootGrid"
          Background="Transparent"
          KeyDown="OnRootKeyDown"
          PointerReleased="OnRootPointerReleased"
          PreviewKeyDown="OnRootPreviewKeyDown"
          PreviewKeyUp="OnRootPreviewKeyUp">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <SolidColorBrush x:Key="OverlayOpaqueBackgroundBrush" Color="{ThemeResource SolidBackgroundFillColorBase}" />
            <Style x:Key="TitleBarActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="7,5,7,5" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="TitleBarGlyphStyle" TargetType="Path">
                <Setter Property="Stroke" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="15" />
            </Style>
            <!-- the taskbar's open-app mark: an accent bar under the glyph while its surface is up -->
            <Style x:Key="TitleBarOpenIndicatorStyle" TargetType="Rectangle">
                <Setter Property="Width" Value="10" />
                <Setter Property="Height" Value="2" />
                <Setter Property="RadiusX" Value="1" />
                <Setter Property="RadiusY" Value="1" />
                <Setter Property="Margin" Value="0,0,0,-4" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            </Style>
            <Style x:Key="TitleBarDividerStyle" TargetType="Rectangle">
                <Setter Property="Width" Value="1" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Margin" Value="4,0,4,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>
        </Grid.Resources>

        <TitleBar x:Name="AppTitleBar"
                  Grid.Row="0"
                  Title="agterm-win"
                  IsPaneToggleButtonVisible="True"
                  Background="Transparent">
            <!-- TitleBar grows to TitleBarExpandedHeight (48) once it has header content, which left
                 the caption buttons at the top of a tall bar. The buttons below fit the compact 32 -->
            <TitleBar.Resources>
                <x:Double x:Key="TitleBarExpandedHeight">32</x:Double>
            </TitleBar.Resources>
            <TitleBar.Content>
                <StackPanel x:Name="ToolbarLabels"
                            Visibility="Collapsed"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Spacing="1">
                    <TextBlock x:Name="ToolbarTitle"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.AutomationId="toolbar-title" />
                    <TextBlock x:Name="ToolbarSubtitle"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.AutomationId="toolbar-subtitle" />
                </StackPanel>
            </TitleBar.Content>
            <!-- upstream titlebarTrailingActions: recent sessions + attention | scratch + split |
                 dashboard + quick terminal. MainWindow.RefreshTitleBarActions sets visibility, the
                 dividers and the glyph states; the shapes are Paths like the sidebar's icons -->
            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button x:Name="RecentSessionsButton"
                            Style="{StaticResource TitleBarActionButtonStyle}"
                            AutomationProperties.Name="Recent sessions"
                            AutomationProperties.AutomationId="recent-sessions-button"
                            ToolTipService.ToolTip="Recent sessions (Ctrl+Tab)">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE81C;" FontSize="14" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="RecentSessionsFlyout"
                                        Placement="BottomEdgeAlignedRight"
                                        Opening="OnRecentSessionsFlyoutOpening" />
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="AttentionButton"
                            Style="{StaticResource TitleBarActionButtonStyle}"
                            Click="OnAttentionClick"
                            AutomationProperties.Name="Attention"
                            AutomationProperties.AutomationId="attention-button">
                        <FontIcon x:Name="AttentionGlyph" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xEA8F;" FontSize="14" />
                    </Button>
                    <Rectangle x:Name="DividerAfterA" Style="{StaticResource TitleBarDividerStyle}" />
                    <Button x:Name="ScratchButton"
                            Style="{StaticResource TitleBarActionButtonStyle}"
                            Click="OnScratchClick"
                            AutomationProperties.Name="Scratch"
                            AutomationProperties.AutomationId="scratch-toggle">
                        <Grid>
                            <Path Style="{StaticResource TitleBarGlyphStyle}" Data="M0.5,2.5 H15.5 V12.5 H0.5 Z" />
                            <Path x:Name="ScratchFill" Style="{StaticResource TitleBarGlyphStyle}"
                                  Fill="{ThemeResource TextFillColorPrimaryBrush}"
                                  Data="M3,5 H13 V10 H3 Z" />
                        </Grid>
                    </Button>
                    <Button x:Name="SplitButton"
                            Style="{StaticResource TitleBarActionButtonStyle}"
                            Click="OnSplitClick"
                            AutomationProperties.Name="Split"
                            AutomationProperties.AutomationId="split-toggle">
                        <Grid>
                            <Path x:Name="SplitLeftFill" Style="{StaticResource TitleBarGlyphStyle}"
                                  Fill="{ThemeResource TextFillColorPrimaryBrush}"
                                  Data="M0.5,2.5 H8 V12.5 H0.5 Z" />
                            <Path x:Name="SplitRightFill" Style="{StaticResource TitleBarGlyphStyle}"
                                  Fill="{ThemeResource TextFillColorPrimaryBrush}"
                                  Data="M8,2.5 H15.5 V12.5 H8 Z" />
                            <Path Style="{StaticResource TitleBarGlyphStyle}" Data="M0.5,2.5 H15.5 V12.5 H0.5 Z M8,2.5 V12.5" />
                        </Grid>
                    </Button>
                    <Rectangle x:Name="DividerAfterB" Style="{StaticResource TitleBarDividerStyle}" />
                    <Button x:Name="DashboardButton"
                            Style="{StaticResource TitleBarActionButtonStyle}"
                            Click="OnDashboardClick"
                            AutomationProperties.Name="Dashboard"
                            AutomationProperties.AutomationId="dashboard-toggle-button"
                            ToolTipService.ToolTip="Dashboard">
                        <Grid>
                            <Path Style="{StaticResource TitleBarGlyphStyle}" Data="M0.5,2.5 H15.5 V12.5 H0.5 Z M8,2.5 V12.5 M0.5,7.5 H15.5" />
                            <Rectangle x:Name="DashboardOpenIndicator" Style="{StaticResource TitleBarOpenIndicatorStyle}" />
                        </Grid>
                    </Button>
                    <Button x:Name="QuickTerminalButton"
                            Style="{StaticResource TitleBarActionButtonStyle}"
                            Click="OnQuickTerminalClick"
                            AutomationProperties.Name="Quick Terminal"
                            AutomationProperties.AutomationId="quick-terminal-toggle"
                            ToolTipService.ToolTip="Quick Terminal">
                        <Grid>
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE756;" FontSize="14" />
                            <Rectangle x:Name="QuickTerminalOpenIndicator" Style="{StaticResource TitleBarOpenIndicatorStyle}" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource TitleBarActionButtonStyle}"
                            AutomationProperties.Name="Settings"
                            AutomationProperties.AutomationId="settings-button"
                            ToolTipService.ToolTip="Settings (Alt+, or Ctrl+,)"
                            Click="OnSettingsClick">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE713;" FontSize="14" />
                    </Button>
                    <!-- upstream's Help menu installers; always shown. MainWindow sets the item texts from
                         InstallerCommands, which the palette and the skill text also use -->
                    <Button x:Name="HelpButton"
                            Style="{StaticResource TitleBarActionButtonStyle}"
                            AutomationProperties.Name="Help"
                            AutomationProperties.AutomationId="help-button"
                            ToolTipService.ToolTip="Help">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE897;" FontSize="14" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="Settings" Click="OnSettingsClick"
                                                KeyboardAcceleratorTextOverride="Alt+, / Ctrl+," />
                                <MenuFlyoutItem Text="Keyboard Shortcuts"
                                                KeyboardAcceleratorTextOverride="Ctrl+Shift+F1"
                                                AutomationProperties.AutomationId="keyboard-shortcuts"
                                                Click="OnKeyboardShortcutsClick" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="InstallCommandLineToolItem"
                                                AutomationProperties.AutomationId="install-command-line-tool"
                                                Click="OnInstallCommandLineToolClick" />
                                <MenuFlyoutItem x:Name="InstallAgentSkillItem"
                                                AutomationProperties.AutomationId="install-agent-skill"
                                                Click="OnInstallAgentSkillClick" />
                                <MenuFlyoutItem x:Name="InstallAgentStatusHooksItem"
                                                AutomationProperties.AutomationId="install-agent-status-hooks"
                                                Click="OnInstallAgentStatusHooksClick" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <SplitView x:Name="ShellSplitView"
                   Grid.Row="1"
                   CompactPaneLength="0"
                   DisplayMode="Inline"
                   IsPaneOpen="True"
                   OpenPaneLength="220"
                   Background="Transparent"
                   PaneBackground="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="WindowWidthStates">
                    <VisualState x:Name="NarrowWindow">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ShellSplitView.DisplayMode" Value="Overlay" />
                            <Setter Target="SidebarDivider.Visibility" Value="Collapsed" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="WideWindow">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="720" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ShellSplitView.DisplayMode" Value="Inline" />
                            <Setter Target="SidebarDivider.Visibility" Value="Visible" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="PresentationStates">
                    <VisualState x:Name="StandardPresentation" />
                    <VisualState x:Name="TerminalOnlyPresentation">
                        <VisualState.Setters>
                            <Setter Target="AppTitleBar.Visibility" Value="Collapsed" />
                            <Setter Target="ShellSplitView.IsPaneOpen" Value="False" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <SplitView.Pane>
                <Grid Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SidebarColumn" Width="220" />
                    </Grid.ColumnDefinitions>

                    <local:SidebarView x:Name="Sidebar" Grid.Column="0" />
                    <local:SidebarResizeHandle x:Name="SidebarDivider"
                            Grid.Column="0"
                            Width="4"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            AutomationProperties.Name="Resize sidebar"
                            PointerPressed="OnDividerPressed"
                            PointerMoved="OnDividerMoved"
                            PointerReleased="OnDividerReleased">
                        <Border Width="1"
                                HorizontalAlignment="Center"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    </local:SidebarResizeHandle>
                </Grid>
            </SplitView.Pane>
            <SplitView.Content>
                <Grid x:Name="TerminalContent">
                    <WebView2 x:Name="TerminalView" />
                    <Border x:Name="ActivationShield"
                            Background="Transparent"
                            Visibility="Collapsed"
                            PointerWheelChanged="OnActivationShieldWheelChanged"
                            PointerPressed="OnActivationShieldPressed"
                            PointerReleased="OnActivationShieldReleased"
                            PointerCanceled="OnActivationShieldReleased"
                            PointerCaptureLost="OnActivationShieldReleased" />
                </Grid>
            </SplitView.Content>
        </SplitView>

        <local:PaletteView x:Name="PaletteOverlay"
                           Grid.RowSpan="2"
                           Canvas.ZIndex="100" />
        <local:AskView x:Name="AskOverlay"
                       Grid.RowSpan="2"
                       Canvas.ZIndex="100" />
        <local:KeybindingsView x:Name="KeybindingsOverlay"
                              Grid.RowSpan="2"
                              Canvas.ZIndex="100" />
        <local:SessionSwitcherView x:Name="SwitcherOverlay"
                                   Grid.Row="1"
                                   Canvas.ZIndex="90" />

        <InfoBar x:Name="NotificationBanner"
                 Grid.Row="1"
                 Margin="16"
                 MaxWidth="480"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 IsClosable="True"
                 IsOpen="False"
                 Severity="Informational"
                 AutomationProperties.Name="Notification"
                 Canvas.ZIndex="90" />

            <InfoBar x:Name="FailureBanner"
                 Grid.Row="1"
                 Margin="16"
                 MaxWidth="560"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 IsClosable="True"
                 IsOpen="False"
                 Severity="Error"
                 AutomationProperties.Name="Application error"
                 Canvas.ZIndex="95">
            <InfoBar.ActionButton>
                <Button x:Name="ReloadTerminalViewButton"
                        Click="OnReloadTerminalViewClick"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Reload terminal view">Reload</Button>
            </InfoBar.ActionButton>
        </InfoBar>

        <InfoBar x:Name="CloseUndoBanner"
                 Grid.Row="1"
                 Margin="16"
                 MaxWidth="480"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 IsClosable="False"
                 IsOpen="False"
                 Severity="Success"
                 AutomationProperties.Name="Recently closed item"
                 Canvas.ZIndex="90">
            <InfoBar.ActionButton>
                <Button Click="OnUndoCloseClick"
                        AutomationProperties.Name="Undo close">Undo</Button>
            </InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</Window>

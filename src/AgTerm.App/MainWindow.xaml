<Window
    x:Class="AgTerm.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgTerm.App"
    Title="agterm">
    <Grid x:Name="RootGrid"
          Background="Transparent"
          KeyDown="OnRootKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar"
                  Grid.Row="0"
                  Title="agterm"
                  IsPaneToggleButtonVisible="True"
                  Background="Transparent" />

        <SplitView x:Name="ShellSplitView"
                   Grid.Row="1"
                   CompactPaneLength="0"
                   DisplayMode="Inline"
                   IsPaneOpen="True"
                   OpenPaneLength="220"
                   Background="Transparent"
                   PaneBackground="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="WindowWidthStates">
                    <VisualState x:Name="NarrowWindow">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ShellSplitView.DisplayMode" Value="Overlay" />
                            <Setter Target="SidebarDivider.Visibility" Value="Collapsed" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="WideWindow">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="720" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ShellSplitView.DisplayMode" Value="Inline" />
                            <Setter Target="SidebarDivider.Visibility" Value="Visible" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="PresentationStates">
                    <VisualState x:Name="StandardPresentation" />
                    <VisualState x:Name="TerminalOnlyPresentation">
                        <VisualState.Setters>
                            <Setter Target="AppTitleBar.Visibility" Value="Collapsed" />
                            <Setter Target="ShellSplitView.IsPaneOpen" Value="False" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <SplitView.Pane>
                <Grid Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SidebarColumn" Width="220" />
                    </Grid.ColumnDefinitions>

                    <local:SidebarView x:Name="Sidebar" Grid.Column="0" />
                    <Border x:Name="SidebarDivider"
                            Grid.Column="0"
                            Width="4"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            AutomationProperties.Name="Resize sidebar"
                            PointerPressed="OnDividerPressed"
                            PointerMoved="OnDividerMoved"
                            PointerReleased="OnDividerReleased">
                        <Border Width="1"
                                HorizontalAlignment="Center"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    </Border>
                </Grid>
            </SplitView.Pane>
            <SplitView.Content>
                <WebView2 x:Name="TerminalView" />
            </SplitView.Content>
        </SplitView>

        <local:PaletteView x:Name="PaletteOverlay"
                           Grid.RowSpan="2"
                           Canvas.ZIndex="100" />

        <InfoBar x:Name="NotificationBanner"
                 Grid.Row="1"
                 Margin="16"
                 MaxWidth="480"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 IsClosable="True"
                 IsOpen="False"
                 Severity="Informational"
                 AutomationProperties.Name="Notification"
                 Canvas.ZIndex="90" />

            <InfoBar x:Name="FailureBanner"
                 Grid.Row="1"
                 Margin="16"
                 MaxWidth="560"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 IsClosable="True"
                 IsOpen="False"
                 Severity="Error"
                 AutomationProperties.Name="Application error"
                 Canvas.ZIndex="95" />

        <InfoBar x:Name="CloseUndoBanner"
                 Grid.Row="1"
                 Margin="16"
                 MaxWidth="480"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 IsClosable="False"
                 IsOpen="False"
                 Severity="Success"
                 AutomationProperties.Name="Recently closed item"
                 Canvas.ZIndex="90">
            <InfoBar.ActionButton>
                <Button Click="OnUndoCloseClick"
                        AutomationProperties.Name="Undo close">Undo</Button>
            </InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</Window>

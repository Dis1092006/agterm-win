<UserControl
    x:Class="AgTerm.App.IconPaletteView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgTerm.App"
    Visibility="Collapsed"
    SizeChanged="OnPaletteSizeChanged"
    AutomationProperties.Name="Workspace icon palette">
    <Grid>
        <Grid x:Name="DismissSurface"
              Background="#66000000"
              PointerPressed="OnDismissSurfacePointerPressed"
              Tapped="OnDismissSurfaceTapped"
              AutomationProperties.AccessibilityView="Raw" />

        <Border x:Name="PalettePanel"
                MaxWidth="520"
                Margin="24,64,24,24"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Style="{StaticResource OverlayPanelStyle}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="32" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="12,6" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              Glyph="&#xE721;"
                              FontSize="14"
                              VerticalAlignment="Center"
                              AutomationProperties.AccessibilityView="Raw" />
                    <TextBox x:Name="QueryBox"
                             Grid.Column="1"
                             Padding="0"
                             VerticalAlignment="Center"
                             Background="Transparent"
                             BorderThickness="0"
                             PlaceholderText="Filter icons"
                             TextChanged="OnQueryBoxTextChanged"
                             KeyDown="OnQueryBoxKeyDown"
                             AutomationProperties.Name="Filter icons" />
                </Grid>

                <Border Grid.Row="1"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <GridView x:Name="IconGrid"
                          Grid.Row="2"
                          Padding="8,4"
                          Background="Transparent"
                          SelectionMode="Single"
                          IsItemClickEnabled="False"
                          IsTabStop="False"
                          DoubleTapped="OnGridDoubleTapped"
                          SelectionChanged="OnGridSelectionChanged"
                          SizeChanged="OnGridSizeChanged"
                          AutomationProperties.Name="Icons">
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Width" Value="36" />
                            <Setter Property="Height" Value="36" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="AllowFocusOnInteraction" Value="False" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:IconPaletteCellItem">
                            <TextBlock Text="{x:Bind Glyph}"
                                       FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       AutomationProperties.Name="{x:Bind Label}" />
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <TextBlock x:Name="LabelText"
                           Grid.Row="3"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           AutomationProperties.Name="Selected icon" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

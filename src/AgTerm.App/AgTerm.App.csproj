<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AgTerm.App</RootNamespace>
    <!-- The exe and its version resource (Task Manager, notifications) carry the product name, not
         upstream's agterm; see ProductIdentity and PLATFORM-NOTES. -->
    <AssemblyName>agterm-win</AssemblyName>
    <Product>agterm-win</Product>
    <AssemblyTitle>agterm-win</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- unpackaged + self-contained WindowsAppSDK: runs anywhere, no MSIX / framework package -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Program.cs checks for a running instance before XAML starts -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260416003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
  </ItemGroup>

  <ItemGroup>
    <!-- the window icons, by taskbar color (TaskbarAppIcon); ApplicationIcon above only sets the exe's own -->
    <EmbeddedResource Include="Assets\AppIcon.ico;Assets\AppIcon-dark-taskbar.ico" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgTerm.Xterm\AgTerm.Xterm.csproj" />
    <ProjectReference Include="..\AgTerm.ControlServer\AgTerm.ControlServer.csproj" />
  </ItemGroup>

</Project>

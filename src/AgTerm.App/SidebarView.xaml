<UserControl
    x:Class="AgTerm.App.SidebarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgTerm.App">
    <!-- the chrome colors, as upstream draws the sidebar: the terminal foreground for text and glyphs,
         at 0.6 for secondary icons, 0.1 for hover and 0.15 for the pill and a press. ApplyChrome sets
         the colors; every use shares these instances -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="SidebarForegroundBrush" Color="#FFCCCCCC" />
        <SolidColorBrush x:Key="SidebarSecondaryBrush" Color="#99CCCCCC" />
        <SolidColorBrush x:Key="SidebarHoverBrush" Color="#1ACCCCCC" />
        <SolidColorBrush x:Key="SidebarPillBrush" Color="#26CCCCCC" />
        <SolidColorBrush x:Key="SidebarWashBrush" Color="Transparent" />
        <SolidColorBrush x:Key="SidebarTransparentBrush" Color="Transparent" />

        <StaticResource x:Key="ListViewItemForeground" ResourceKey="SidebarForegroundBrush" />
        <StaticResource x:Key="ListViewItemForegroundPointerOver" ResourceKey="SidebarForegroundBrush" />
        <StaticResource x:Key="ListViewItemForegroundSelected" ResourceKey="SidebarForegroundBrush" />
        <StaticResource x:Key="ListViewItemForegroundPressed" ResourceKey="SidebarForegroundBrush" />
        <StaticResource x:Key="ListViewItemForegroundSelectedPointerOver" ResourceKey="SidebarForegroundBrush" />
        <StaticResource x:Key="ListViewItemForegroundSelectedPressed" ResourceKey="SidebarForegroundBrush" />

        <!-- upstream's borderless buttons: no fill or frame at rest, the glyph in the chrome
             foreground in every state; a light fill on hover and press keeps the pointer visible -->
        <StaticResource x:Key="ButtonForeground" ResourceKey="SidebarForegroundBrush" />
        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SidebarForegroundBrush" />
        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SidebarForegroundBrush" />
        <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="SidebarForegroundBrush" />
        <StaticResource x:Key="ButtonBackground" ResourceKey="SidebarTransparentBrush" />
        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SidebarHoverBrush" />
        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SidebarPillBrush" />
        <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SidebarTransparentBrush" />
        <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SidebarTransparentBrush" />
        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SidebarTransparentBrush" />
        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SidebarTransparentBrush" />
        <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="SidebarTransparentBrush" />
        <StaticResource x:Key="ToggleButtonForeground" ResourceKey="SidebarForegroundBrush" />
        <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="SidebarForegroundBrush" />
        <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="SidebarForegroundBrush" />
        <StaticResource x:Key="ToggleButtonForegroundDisabled" ResourceKey="SidebarForegroundBrush" />
        <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="SidebarForegroundBrush" />
        <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="SidebarForegroundBrush" />
        <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="SidebarForegroundBrush" />
        <StaticResource x:Key="ToggleButtonForegroundCheckedDisabled" ResourceKey="SidebarForegroundBrush" />
        <StaticResource x:Key="ToggleButtonBackground" ResourceKey="SidebarTransparentBrush" />
        <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SidebarHoverBrush" />
        <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SidebarPillBrush" />
        <StaticResource x:Key="ToggleButtonBackgroundDisabled" ResourceKey="SidebarTransparentBrush" />
        <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SidebarTransparentBrush" />
        <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SidebarHoverBrush" />
        <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SidebarPillBrush" />
        <StaticResource x:Key="ToggleButtonBackgroundCheckedDisabled" ResourceKey="SidebarTransparentBrush" />
        <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="SidebarTransparentBrush" />
        <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="SidebarTransparentBrush" />
        <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="SidebarTransparentBrush" />
        <StaticResource x:Key="ToggleButtonBorderBrushDisabled" ResourceKey="SidebarTransparentBrush" />
        <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="SidebarTransparentBrush" />
        <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="SidebarTransparentBrush" />
        <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="SidebarTransparentBrush" />
        <StaticResource x:Key="ToggleButtonBorderBrushCheckedDisabled" ResourceKey="SidebarTransparentBrush" />

        <!-- upstream bottomBar's 24x22 glyph frame -->
        <Style x:Key="SidebarFooterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource SidebarForegroundBrush}" />
        </Style>
        <Style x:Key="SidebarFooterToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource SidebarForegroundBrush}" />
        </Style>
    </UserControl.Resources>

    <!-- transparent: the window's split view pane paints the theme background once, so a
         translucent theme is not stacked twice -->
    <Grid x:Name="SidebarRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="BackgroundShiftOverlay"
                Grid.RowSpan="2"
                Background="{StaticResource SidebarWashBrush}"
                IsHitTestVisible="False" />

        <ListView x:Name="RowsList"
                  Grid.Row="0"
                  Background="Transparent"
                  IsDoubleTapEnabled="False"
                  SelectionMode="Extended"
                  CanDragItems="True"
                  AllowDrop="True"
                  ContainerContentChanging="OnRowsListContainerContentChanging"
                  SelectionChanged="OnSelectionChanged"
                  DragItemsStarting="OnDragItemsStarting"
                  DragOver="OnListDragOver"
                  Drop="OnListDrop"
                  ContextRequested="OnRowContextRequested"
                  Tapped="OnRowTapped"
                  KeyDown="OnListKeyDown">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:SidebarRowViewModel">
                    <!-- transparent, not null: the whole row is hit-testable, so the pointer
                         events that reveal the workspace "+" fire over its empty space too -->
                    <Grid Height="{x:Bind RowHeight, Mode=OneWay}"
                          Background="Transparent"
                          PointerEntered="OnRowPointerEntered"
                          PointerExited="OnRowPointerExited"
                          PointerCanceled="OnRowPointerExited">
                    <!-- the colored layer of a themed row: opaque, so the selected and hover
                         backgrounds under it never show. The owner found the item's 4 px corner
                         radius and a 4 px gap between colored rows too large. The content sits
                         on top at the container's old 8 px padding, so a default row is laid out
                         as before -->
                    <Border Background="{x:Bind RowBackground, Mode=OneWay}"
                            BackgroundSizing="OuterBorderEdge"
                            BorderBrush="{x:Bind RowFrame, Mode=OneWay}"
                            BorderThickness="1"
                            CornerRadius="2"
                            Margin="4,1,4,1" />
                    <Grid ColumnSpacing="6" Margin="{x:Bind ContentMargin, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- workspace chevron -->
                        <FontIcon Grid.Column="0"
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  Glyph="{x:Bind Chevron, Mode=OneWay}"
                                  FontSize="10"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="{x:Bind ChevronAutomationName, Mode=OneWay}"
                                  AutomationProperties.AccessibilityView="Raw"
                                  local:SidebarRowBrushes.Foreground="{x:Bind RowForeground, Mode=OneWay}"
                                  Visibility="{x:Bind WorkspaceVisibility, Mode=OneWay}" />

                        <!-- session icon: terminal rect (+split divider), filled when flagged -->
                        <Path Grid.Column="0"
                              Data="{x:Bind IconData, Mode=OneWay}"
                              Fill="{x:Bind IconFill, Mode=OneWay}"
                              local:SidebarRowBrushes.Foreground="{x:Bind RowForeground, Mode=OneWay}"
                              StrokeThickness="1"
                              Width="16" Height="15"
                              VerticalAlignment="Center"
                              Visibility="{x:Bind SessionVisibility, Mode=OneWay}">
                            <!-- in a style, so clearing the theme stroke on a default row falls back to it -->
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Stroke" Value="{StaticResource SidebarSecondaryBrush}" />
                                </Style>
                            </Path.Style>
                        </Path>

                        <!-- left-aligned, so the star column is as wide as the name until the
                             name needs more than the column has, and then the name trims. A
                             horizontal StackPanel measured it with unlimited width, so it never
                             trimmed -->
                        <Grid Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- workspace icon: upstream's square.grid.2x2, drawn like the session
                                 icon. A margin, not column spacing, so a session row leaves no gap -->
                            <Path Data="M1.5,1.5 H6.5 V6.5 H1.5 Z M9.5,1.5 H14.5 V6.5 H9.5 Z M1.5,8.5 H6.5 V13.5 H1.5 Z M9.5,8.5 H14.5 V13.5 H9.5 Z"
                                  local:SidebarRowBrushes.Foreground="{x:Bind RowForeground, Mode=OneWay}"
                                  StrokeThickness="1"
                                  Width="16" Height="15"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center"
                                  Visibility="{x:Bind GridIconVisibility, Mode=OneWay}">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Stroke" Value="{StaticResource SidebarSecondaryBrush}" />
                                    </Style>
                                </Path.Style>
                            </Path>
                            <!-- a Segoe icon the workspace chose; the grid shows when it has none -->
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      Glyph="{x:Bind WorkspaceGlyph, Mode=OneWay}"
                                      FontSize="14"
                                      Width="16"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center"
                                      local:SidebarRowBrushes.Foreground="{x:Bind RowForeground, Mode=OneWay}"
                                      Visibility="{x:Bind WorkspaceGlyphVisibility, Mode=OneWay}">
                                <FontIcon.Style>
                                    <Style TargetType="FontIcon">
                                        <Setter Property="Foreground" Value="{StaticResource SidebarSecondaryBrush}" />
                                    </Style>
                                </FontIcon.Style>
                            </FontIcon>
                            <!-- an image file the workspace chose keeps its own colors -->
                            <Image Source="{x:Bind WorkspaceImage, Mode=OneWay}"
                                   Width="16" Height="16"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   Visibility="{x:Bind WorkspaceImageVisibility, Mode=OneWay}" />
                            <!-- the block of the label style -->
                            <Border Grid.Column="1"
                                    Background="{x:Bind LabelBlockBackground, Mode=OneWay}"
                                    CornerRadius="2"
                                    Padding="{x:Bind LabelBlockPadding, Mode=OneWay}"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind LabelVisibility, Mode=OneWay}">
                                <TextBlock Text="{x:Bind Label, Mode=OneWay}"
                                           FontSize="{x:Bind FontSize, Mode=OneWay}"
                                           FontWeight="{x:Bind LabelWeight, Mode=OneWay}"
                                           local:SidebarRowBrushes.Foreground="{x:Bind LabelForeground, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                            <TextBox Grid.Column="1"
                                     Text="{x:Bind EditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{x:Bind EditorVisibility, Mode=OneWay}"
                                     MinHeight="22" Padding="4,1,4,1"
                                     FontSize="{x:Bind FontSize, Mode=OneWay}"
                                     KeyDown="OnRenameKeyDown"
                                     LostFocus="OnRenameLostFocus"
                                     Loaded="OnRenameEditorLoaded" />
                            <!-- a margin, not column spacing, so a hidden icon leaves no gap -->
                            <FontIcon Grid.Column="2"
                                      Margin="6,0,0,0"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      Glyph="&#xE72E;"
                                      FontSize="10"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="{x:Bind FocusedWorkspaceAutomationName, Mode=OneWay}"
                                      AutomationProperties.AccessibilityView="Raw"
                                      local:SidebarRowBrushes.Foreground="{x:Bind RowForeground, Mode=OneWay}"
                                      Visibility="{x:Bind FocusPillVisibility, Mode=OneWay}" />
                        </Grid>

                        <!-- lifecycle status (ready has no icon): pending ring or failed marker -->
                        <Grid Grid.Column="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <ProgressRing Width="12" Height="12"
                                        IsActive="True"
                                        Visibility="{x:Bind PendingVisibility, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind SurfaceAutomationName, Mode=OneWay}"
                                        AutomationProperties.AccessibilityView="Raw" />
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      Glyph="&#xEA39;"
                                      FontSize="12"
                                      Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                      Visibility="{x:Bind FailedVisibility, Mode=OneWay}"
                                      AutomationProperties.Name="{x:Bind SurfaceAutomationName, Mode=OneWay}"
                                      AutomationProperties.AccessibilityView="Raw" />
                        </Grid>

                        <!-- agent-status glyph -->
                        <Path Grid.Column="3"
                              x:Name="StatusGlyph"
                              Data="{x:Bind GlyphData, Mode=OneWay}"
                              Fill="{x:Bind GlyphFill, Mode=OneWay}"
                              Width="13" Height="13"
                              VerticalAlignment="Center"
                              Visibility="{x:Bind GlyphVisibility, Mode=OneWay}"
                              AutomationProperties.Name="{x:Bind AgentAutomationName, Mode=OneWay}"
                              AutomationProperties.AccessibilityView="Raw"
                              Loaded="OnGlyphLoaded" />

                        <!-- workspace "+": New Session, revealed on hover (upstream
                             workspace-add-session). A workspace row never shows the agent glyph,
                             so it takes that column, next to the badge as upstream. Hover-only like
                             upstream, so it stays out of the tab order; the row menu and the hotkey
                             cover the keyboard -->
                        <Button Grid.Column="3"
                                Width="16" Height="16" MinWidth="0" MinHeight="0"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalAlignment="Center"
                                IsTabStop="False"
                                Visibility="{x:Bind AddSessionVisibility, Mode=OneWay}"
                                Click="OnAddSessionClick"
                                AutomationProperties.Name="New Session"
                                AutomationProperties.AutomationId="workspace-add-session"
                                ToolTipService.ToolTip="New Session">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      Glyph="&#xE710;"
                                      FontSize="10"
                                      local:SidebarRowBrushes.Foreground="{x:Bind RowForeground, Mode=OneWay}" />
                        </Button>

                        <!-- unseen badge -->
                        <Border Grid.Column="4"
                                Background="#E81123"
                                CornerRadius="8"
                                MinWidth="16" Height="16"
                                Padding="4,0,4,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Bind UnseenAutomationName, Mode=OneWay}"
                                AutomationProperties.AccessibilityView="Raw"
                                Visibility="{x:Bind BadgeVisibility, Mode=OneWay}">
                            <TextBlock Text="{x:Bind BadgeText, Mode=OneWay}"
                                       Foreground="White"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- upstream bottomBar: the add controls on the left; the focus pill and the flagged-view
             toggle on the right. The port keeps Clear flagged next to the toggle: nothing else in
             the window clears the flags. No line above it, as upstream -->
        <Grid x:Name="SidebarFooter" Grid.Row="1" Padding="6,4,6,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="SidebarFooterLeading" Orientation="Horizontal" Spacing="2">
                <!-- upstream rectangle.stack.badge.plus: a stack of rectangles with a plus -->
                <Button x:Name="NewWorkspaceButton"
                        Style="{StaticResource SidebarFooterButtonStyle}"
                        Click="OnNewWorkspaceClick"
                        AutomationProperties.Name="New workspace"
                        ToolTipService.ToolTip="New workspace">
                    <Path Data="M3.5,0.5 H12.5 M1.5,2.5 H14.5 M0.5,4.5 H15.5 V14.5 H0.5 Z M8,7 V12 M5.5,9.5 H10.5"
                          Stroke="{StaticResource SidebarForegroundBrush}"
                          StrokeThickness="1"
                          Width="16" Height="15" />
                </Button>
                <!-- upstream's New Session menu (add-session): plus.rectangle, a terminal rect with a
                     plus, drawn as a Path like the rows' icons -->
                <Button x:Name="NewSessionButton"
                        Style="{StaticResource SidebarFooterButtonStyle}"
                        AutomationProperties.Name="Add session"
                        AutomationProperties.AutomationId="add-session"
                        ToolTipService.ToolTip="New Session">
                    <Path Data="M0.5,2.5 H15.5 V12.5 H0.5 Z M8,5 V10 M5.5,7.5 H10.5"
                          Stroke="{StaticResource SidebarForegroundBrush}"
                          StrokeThickness="1"
                          Width="16" Height="15" />
                    <Button.Flyout>
                        <MenuFlyout Placement="TopEdgeAlignedLeft">
                            <MenuFlyoutItem Text="New Session" Click="OnFooterNewSessionClick" />
                            <MenuFlyoutItem Text="Open Directory…" Click="OnFooterOpenDirectoryClick" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <StackPanel x:Name="SidebarFooterTrailing" Grid.Column="1" Orientation="Horizontal" Spacing="2">
                <Button x:Name="FocusPill"
                        Style="{StaticResource SidebarFooterButtonStyle}"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Clear workspace focus"
                        ToolTipService.ToolTip="Clear focus"
                        Click="OnFocusPillClick">
                    <Border Background="{StaticResource SidebarPillBrush}" CornerRadius="9" Padding="7,2,7,2">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:Name="FocusPillText"
                                       FontSize="12"
                                       MaxWidth="120"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      Glyph="&#xE711;" FontSize="9" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Button>
                <Button x:Name="ClearFlaggedButton"
                        Style="{StaticResource SidebarFooterButtonStyle}"
                        Visibility="Collapsed"
                        Click="OnClearFlaggedClick"
                        AutomationProperties.Name="Clear flagged sessions"
                        ToolTipService.ToolTip="Clear flagged sessions">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              Glyph="&#xE711;" FontSize="10" />
                </Button>
                <!-- upstream flag / flag.fill; a ToggleButton so UI Automation reports the view -->
                <ToggleButton x:Name="FlaggedToggle"
                              Style="{StaticResource SidebarFooterToggleStyle}"
                              Click="OnFlaggedToggleClick"
                              AutomationProperties.Name="Flagged sessions"
                              ToolTipService.ToolTip="Flagged view">
                    <Path x:Name="FlaggedGlyph"
                          Data="M3.5,0.5 V14.5 M3.5,1.5 H13 L10.5,5 L13,8.5 H3.5 Z"
                          Stroke="{StaticResource SidebarForegroundBrush}"
                          StrokeThickness="1"
                          Width="16" Height="15" />
                </ToggleButton>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

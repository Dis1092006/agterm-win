<UserControl
    x:Class="AgTerm.App.SidebarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgTerm.App">
    <Grid Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListView x:Name="RowsList"
                  Grid.Row="0"
                  Background="Transparent"
                  SelectionMode="Extended"
                  CanDragItems="True"
                  AllowDrop="True"
                  IsDoubleTapEnabled="True"
                  SelectionChanged="OnSelectionChanged"
                  DragItemsStarting="OnDragItemsStarting"
                  DragOver="OnListDragOver"
                  Drop="OnListDrop"
                  RightTapped="OnRowRightTapped"
                  DoubleTapped="OnRowDoubleTapped"
                  Tapped="OnRowTapped"
                  KeyDown="OnListKeyDown">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="28" />
                    <Setter Property="Padding" Value="8,0,8,0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:SidebarRowViewModel">
                    <Grid ColumnSpacing="6" Height="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- workspace chevron -->
                        <FontIcon Grid.Column="0"
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  Glyph="{x:Bind Chevron, Mode=OneWay}"
                                  FontSize="10"
                                  VerticalAlignment="Center"
                                  Visibility="{x:Bind WorkspaceVisibility, Mode=OneWay}" />

                        <!-- session icon: terminal rect (+split divider), filled when flagged -->
                        <Path Grid.Column="0"
                              Data="{x:Bind IconData, Mode=OneWay}"
                              Fill="{x:Bind IconFill, Mode=OneWay}"
                              Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                              StrokeThickness="1"
                              Width="16" Height="15"
                              VerticalAlignment="Center"
                              Visibility="{x:Bind SessionVisibility, Mode=OneWay}" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Label, Mode=OneWay}"
                                       FontWeight="{x:Bind LabelWeight, Mode=OneWay}"
                                       Opacity="{x:Bind LabelOpacity, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{x:Bind LabelVisibility, Mode=OneWay}" />
                            <TextBox Text="{x:Bind EditText, Mode=TwoWay}"
                                     Visibility="{x:Bind EditorVisibility, Mode=OneWay}"
                                     MinHeight="22" Padding="4,1,4,1" FontSize="12"
                                     KeyDown="OnRenameKeyDown"
                                     LostFocus="OnRenameLostFocus"
                                     Loaded="OnRenameEditorLoaded" />
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      Glyph="&#xE72E;"
                                      FontSize="10"
                                      VerticalAlignment="Center"
                                      Visibility="{x:Bind FocusPillVisibility, Mode=OneWay}" />
                        </StackPanel>

                        <!-- agent-status glyph -->
                        <Path Grid.Column="2"
                              x:Name="StatusGlyph"
                              Data="{x:Bind GlyphData, Mode=OneWay}"
                              Fill="{x:Bind GlyphFill, Mode=OneWay}"
                              Width="13" Height="13"
                              VerticalAlignment="Center"
                              Visibility="{x:Bind GlyphVisibility, Mode=OneWay}"
                              Loaded="OnGlyphLoaded" />

                        <!-- unseen badge -->
                        <Border Grid.Column="3"
                                Background="#E81123"
                                CornerRadius="8"
                                MinWidth="16" Height="16"
                                Padding="4,0,4,0"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind BadgeVisibility, Mode=OneWay}">
                            <TextBlock Text="{x:Bind BadgeText, Mode=OneWay}"
                                       Foreground="White"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- bottom bar: flagged-view toggle + focus pill -->
        <Grid Grid.Row="1" Padding="8,4,8,6" ColumnSpacing="6"
              BorderThickness="0,1,0,0"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ToggleButton x:Name="FlaggedToggle"
                          Grid.Column="0"
                          Padding="6,2,6,2"
                          Click="OnFlaggedToggleClick"
                          ToolTipService.ToolTip="Flagged view">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          Glyph="&#xE7C1;" FontSize="12" />
            </ToggleButton>
            <Button x:Name="FocusPill"
                    Grid.Column="1"
                    Padding="6,2,6,2"
                    Visibility="Collapsed"
                    Click="OnFocusPillClick">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock x:Name="FocusPillText" FontSize="11" />
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              Glyph="&#xE711;" FontSize="9" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3"
                    Padding="6,2,6,2"
                    Click="OnNewWorkspaceClick"
                    ToolTipService.ToolTip="New workspace">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          Glyph="&#xE710;" FontSize="12" />
            </Button>
        </Grid>
    </Grid>
</UserControl>

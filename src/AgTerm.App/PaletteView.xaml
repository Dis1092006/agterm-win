<UserControl
    x:Class="AgTerm.App.PaletteView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgTerm.App"
    Visibility="Collapsed"
    SizeChanged="OnPaletteSizeChanged"
    AutomationProperties.Name="Palette">
    <Grid>
        <Grid x:Name="DismissSurface"
              Background="Transparent"
              PointerPressed="OnDismissSurfacePointerPressed"
              Tapped="OnDismissSurfaceTapped"
              AutomationProperties.AccessibilityView="Raw">
            <Border x:Name="Scrim"
                    Background="#33000000"
                    IsHitTestVisible="False" />
        </Grid>

        <Border x:Name="PalettePanel"
                MaxWidth="520"
                Margin="24,64,24,24"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Style="{StaticResource OverlayPanelStyle}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="12,6" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              Glyph="&#xE721;"
                              FontSize="14"
                              VerticalAlignment="Center"
                              AutomationProperties.AccessibilityView="Raw" />
                    <TextBox x:Name="QueryBox"
                             Grid.Column="1"
                             Padding="0"
                             VerticalAlignment="Center"
                             Background="Transparent"
                             BorderThickness="0"
                             TextChanged="OnQueryBoxTextChanged"
                             KeyDown="OnQueryBoxKeyDown"
                             AutomationProperties.Name="Filter palette items" />
                </Grid>

                <Border Grid.Row="1"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <ListView x:Name="ResultsList"
                          Grid.Row="2"
                          MaxHeight="320"
                          Background="Transparent"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          IsTabStop="False"
                          ItemClick="OnResultItemClick"
                          SelectionChanged="OnResultsSelectionChanged"
                          AutomationProperties.Name="Palette results">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="44" />
                            <Setter Property="Padding" Value="12,4" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:PaletteItemViewModel">
                            <Grid MinHeight="36"
                                  ColumnSpacing="10"
                                  AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- an editor row's membership: the sidebar's flag or grid, a flag
                                     filled and a grid heavier when on -->
                                <Grid Grid.Column="0"
                                      Width="18"
                                      VerticalAlignment="Center"
                                      Visibility="{x:Bind HasMark, Mode=OneWay}"
                                      AutomationProperties.AutomationId="palette-mark"
                                      AutomationProperties.Name="{x:Bind MarkValue, Mode=OneWay}">
                                    <Path Data="{x:Bind MarkData, Mode=OneWay}"
                                          Width="16" Height="15"
                                          HorizontalAlignment="Left"
                                          StrokeThickness="1"
                                          Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                          Visibility="{x:Bind MarkOutlined, Mode=OneWay}" />
                                    <Path Data="{x:Bind MarkData, Mode=OneWay}"
                                          Width="16" Height="15"
                                          HorizontalAlignment="Left"
                                          Fill="{ThemeResource TextFillColorPrimaryBrush}"
                                          Visibility="{x:Bind MarkFilled, Mode=OneWay}" />
                                    <Path Data="{x:Bind MarkData, Mode=OneWay}"
                                          Width="16" Height="15"
                                          HorizontalAlignment="Left"
                                          StrokeThickness="{x:Bind MarkStrokeThickness, Mode=OneWay}"
                                          Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                          Visibility="{x:Bind MarkOn, Mode=OneWay}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind Badge, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3"
                                           Text="{x:Bind Shortcut, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <local:SessionStatusGlyph Grid.Column="4"
                                                          ShapeData="{x:Bind GlyphData, Mode=OneWay}"
                                                          ColorHex="{x:Bind StatusColor, Mode=OneWay}"
                                                          Shown="{x:Bind HasStatusGlyph, Mode=OneWay}"
                                                          VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border x:Name="HintDivider"
                        Grid.Row="3"
                        Height="1"
                        Visibility="Collapsed"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <TextBlock x:Name="HintText"
                           Grid.Row="4"
                           Padding="12,6"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           AutomationProperties.AutomationId="palette-editor-hint" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
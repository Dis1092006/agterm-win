<UserControl
    x:Class="AgTerm.App.PaletteView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgTerm.App"
    Visibility="Collapsed"
    SizeChanged="OnPaletteSizeChanged"
    AutomationProperties.Name="Palette">
    <UserControl.Resources>
        <local:PaletteStatusBrushConverter x:Key="PaletteStatusBrushConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid x:Name="DismissSurface"
              Background="#66000000"
              PointerPressed="OnDismissSurfacePointerPressed"
              Tapped="OnDismissSurfaceTapped"
              AutomationProperties.AccessibilityView="Raw" />

        <Border x:Name="PalettePanel"
                MaxWidth="520"
                Margin="24,64,24,24"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="12,6" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              Glyph="&#xE721;"
                              FontSize="14"
                              VerticalAlignment="Center"
                              AutomationProperties.AccessibilityView="Raw" />
                    <TextBox x:Name="QueryBox"
                             Grid.Column="1"
                             Padding="0"
                             VerticalAlignment="Center"
                             Background="Transparent"
                             BorderThickness="0"
                             TextChanged="OnQueryBoxTextChanged"
                             KeyDown="OnQueryBoxKeyDown"
                             AutomationProperties.Name="Filter palette items" />
                </Grid>

                <Border Grid.Row="1"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <ListView x:Name="ResultsList"
                          Grid.Row="2"
                          MaxHeight="320"
                          Background="Transparent"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          IsTabStop="False"
                          ItemClick="OnResultItemClick"
                          SelectionChanged="OnResultsSelectionChanged"
                          AutomationProperties.Name="Palette results">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="44" />
                            <Setter Property="Padding" Value="12,4" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:PaletteItemViewModel">
                            <Grid MinHeight="36"
                                  ColumnSpacing="10"
                                  AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind StatusGlyph, Mode=OneWay}"
                                           Foreground="{Binding StatusColor, Converter={StaticResource PaletteStatusBrushConverter}}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           AutomationProperties.AccessibilityView="Raw" />
                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind Badge, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3"
                                           Text="{x:Bind Shortcut, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
<UserControl
    x:Class="AgTerm.App.HtmlOverlayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed"
    IsTabStop="False">
    <!-- upstream HtmlOverlayView: the identity strip, a rule, then the page with the failure view over
         it. The root has no background, so outside a floating panel the terminal takes the clicks -->
    <Canvas x:Name="Area">
        <Border x:Name="PagePanel"
                AutomationProperties.AutomationId="htmlOverlay">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="StripRow" Height="28" />
                    <RowDefinition x:Name="RuleRow" Height="1" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid x:Name="Strip" Padding="10,0,10,0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="LeadingButtons" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" />
                    <Grid x:Name="Label" Grid.Column="1" VerticalAlignment="Center">
                        <Grid HorizontalAlignment="Center" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="IdentityText"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       AutomationProperties.AutomationId="htmlOverlay.identity" />
                            <TextBlock x:Name="TitleDot" Grid.Column="1" FontSize="12" Text="·" />
                            <TextBlock x:Name="TitleText"
                                       Grid.Column="2"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       AutomationProperties.AutomationId="htmlOverlay.title" />
                        </Grid>
                    </Grid>
                    <StackPanel x:Name="TrailingButtons" Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" />
                </Grid>
                <Border x:Name="Rule" Grid.Row="1" />
                <Grid x:Name="PageHost" Grid.Row="2" />
                <Grid x:Name="FailureView"
                      Grid.Row="2"
                      Padding="24"
                      Visibility="Collapsed"
                      AutomationProperties.AutomationId="htmlOverlay.error">
                    <StackPanel VerticalAlignment="Center" Spacing="8">
                        <FontIcon x:Name="FailureIcon" Glyph="&#xE7BA;" FontSize="24" />
                        <TextBlock x:Name="FailureTitle"
                                   HorizontalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="The page could not be loaded" />
                        <TextBlock x:Name="FailureError"
                                   HorizontalAlignment="Center"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Canvas>
</UserControl>

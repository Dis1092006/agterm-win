<UserControl
    x:Class="AgTerm.App.AskView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed"
    IsTabStop="True"
    UseSystemFocusVisuals="False"
    KeyDown="OnKeyDown"
    AutomationProperties.Name="Question">
    <Canvas x:Name="Root" Background="Transparent">
        <Border x:Name="Scrim" Background="#33000000" />
        <Border x:Name="Panel"
                Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                Translation="0,0,32"
                AutomationProperties.AutomationId="ask-dialog">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <ScrollViewer x:Name="PanelScroll"
                          HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          IsTabStop="False">
                <StackPanel x:Name="ContentStack" Spacing="12">
                    <TextBlock x:Name="TitleText"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="ask-title" />
                    <TextBlock x:Name="MessageText"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="ask-message" />
                    <Grid x:Name="ButtonHost" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Canvas>
</UserControl>

<Project>

  <PropertyGroup>
    <!-- SDK artifacts output layout (.NET 8+): every project's bin/obj/publish output is gathered
         under artifacts\ instead of scattered per-project bin\ and obj\ directories.
         https://learn.microsoft.com/dotnet/core/sdk/artifacts-output -->
    <UseArtifactsOutput>true</UseArtifactsOutput>

    <!-- The app version. The plugin manifests under plugins/agterm and .claude-plugin/marketplace.json carry
         the same string, and SkillTextTests checks that they match. Raise it by hand, together with them,
         when the skill changes: Claude Code does not update an installed plugin while the version stays
         the same. It is not tied to upstream agterm's version numbers. -->
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>

<Project>

  <PropertyGroup>
    <!-- SDK artifacts output layout (.NET 8+): every project's bin/obj/publish output is gathered
         under artifacts\ instead of scattered per-project bin\ and obj\ directories.
         https://learn.microsoft.com/dotnet/core/sdk/artifacts-output -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- The app version. Every PR raises it by hand. The plugin manifests under plugins/agterm and
         .claude-plugin/marketplace.json carry their own version, which goes up only when the skill changes
         (CLAUDE.md). It is not tied to upstream agterm's version numbers. -->
    <Version>0.1.57</Version>
  </PropertyGroup>

</Project>
